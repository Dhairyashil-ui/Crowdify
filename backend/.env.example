# Croudify — Backend Environment Configuration
# =============================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to git.

# ── MongoDB ──────────────────────────────────────────────────────────────────
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_DB=croudify

# ── Razorpay (LIVE keys) ──────────────────────────────────────────────────────
# Get from: https://dashboard.razorpay.com → Settings → API Keys
# REGENERATE IMMEDIATELY if previously exposed.
RAZORPAY_KEY_ID=rzp_live_XXXXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
RAZORPAY_WEBHOOK_SECRET=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ── x402 / Algorand TestNet ───────────────────────────────────────────────────
# Algorand TestNet wallet address (base32, no checksum suffix)
X402_PAY_TO_ADDRESS=
X402_NETWORK=algorand-testnet
X402_PRICE=$0.001
X402_FACILITATOR_URL=https://x402.goplus.com/facilitator
